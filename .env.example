# Copy to .env and fill in. Never commit .env.
#
# SPLIT BY PRIVILEGE — this is the security model, not a formatting choice:
#
#   [INGEST]  runs locally on a maintainer's machine. Holds write credentials.
#   [API]     deployed to Vercel, public repo, outside contributors. Read-only.
#
# The service-role key must NEVER appear in the API section or in Vercel's
# environment. If a credential from the deployed surface leaks, the worst case
# should be read access to data that is already public by definition.

# ---------------------------------------------------------------------------
# [INGEST] — local only
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # write access. Local machine only.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=public-domain-archive
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Pinned embedding model. MUST match the model the API uses at query time, or
# similarity scores are meaningless. Enforced by tests/test_model_parity.py.
EMBED_MODEL=openai/clip-vit-base-patch32

# Sent to every source API. Be a good citizen: identify yourself and give them
# a way to contact you before they have to rate-limit you.
INGEST_USER_AGENT=public_domain_archive/0.1 (+https://github.com/DanKam0001/public_domain_archive)

# ---------------------------------------------------------------------------
# [API] — safe to deploy
# ---------------------------------------------------------------------------
SUPABASE_ANON_KEY=                    # read-only, constrained by RLS
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
